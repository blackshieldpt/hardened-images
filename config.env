# Primary registry (public). Images publish to ${REGISTRY}/${IMAGE_PREFIX}/<image>.
REGISTRY=ghcr.io
IMAGE_PREFIX=blackshieldpt

# Optional mirror to a second registry. Left unset here; in CI it is supplied
# from repository secrets (MIRROR_REGISTRY, MIRROR_PREFIX, MIRROR_USERNAME,
# MIRROR_PASSWORD). When MIRROR_REGISTRY is empty the mirror step is skipped.

# Optional SBOM upload to a Dependency-Track instance. Left unset here; in CI it
# is supplied from repository secrets (DTRACK_URL, DTRACK_API_KEY). When
# DTRACK_URL is empty the upload step is skipped.

# Image tags for apk-native images and config-only packages. Images built from
# source or repackaged from an upstream artifact (clickhouse, etcd, mailpit,
# manticore, openbao, redpanda, versitygw, zookeeper) take their version from
# images/<name>/melange.yaml (package.version) instead.
VERSION_nginx=1.31
# nginx-acme is the nginx image plus lego; it tracks the same nginx line, so bump
# both together. (Its lego version is pinned in images/nginx-acme/melange.yaml.)
VERSION_nginx_acme=1.31
VERSION_node=22   # pinned-line (this image exists to track Node 22; node24 tracks 24)
VERSION_node24=24 # pinned-line (this image exists to track Node 24)
VERSION_postgresql=18
VERSION_valkey=9.1
VERSION_minio=0.20260717.120751
VERSION_nats=2.14.1
VERSION_python=3.14
VERSION_python_sodium=3.14
VERSION_go=1.27
VERSION_kafka=4.3

# Vulnerability scan threshold (CRITICAL, HIGH, MEDIUM, LOW)
SEVERITY_THRESHOLD=CRITICAL

# Scan gate: 1 (default) blocks publish on unwaived findings at/above the
# threshold; 0 makes scanning advisory. Waive individual CVEs with OpenVEX
# instead of disabling the gate — see vex/README.md.
SCAN_GATE=1

# Keyless (Fulcio/OIDC) signing + verification. In CI, cosign signs with the
# workflow's ambient OIDC identity; verification pins that identity.
# COSIGN_IDENTITY is a regexp matched against the signing certificate identity.
COSIGN_IDENTITY=https://github.com/blackshieldpt/hardened-images/.github/workflows/.*
COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com
